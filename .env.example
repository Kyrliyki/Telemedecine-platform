# Copy to .env and adjust secrets.

# PostgreSQL
POSTGRES_DB=telemedicine
POSTGRES_USER=telemedicine
POSTGRES_PASSWORD=telemedicine
POSTGRES_PORT=55432

# Database passwords
AUTH_DB_PASSWORD=auth_svc
USER_DB_PASSWORD=user_svc
SCHEDULE_DB_PASSWORD=schedule_svc
EMR_DB_PASSWORD=emr_svc
APPOINTMENT_DB_PASSWORD=appointment
CHAT_DB_PASSWORD=chat
FILE_DB_PASSWORD=file
VIDEO_DB_PASSWORD=video
NOTIFICATION_DB_PASSWORD=notification

# Schemas
AUTH_DB_SCHEMA=auth_service
USER_DB_SCHEMA=user_service
SCHEDULE_DB_SCHEMA=schedule_service
EMR_DB_SCHEMA=emr_service

# Redis
REDIS_PORT=6379
VIDEO_REDIS_URL=redis://redis:6379/4

# RabbitMQ
RABBITMQ_USER=telemedicine
RABBITMQ_PASSWORD=telemedicine
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ROOT_USER=telemedicine
MINIO_ROOT_PASSWORD=telemedicine123
MINIO_BUCKETS=telemedicine,chat-files
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
FILE_BUCKET=chat-files
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900
MAX_FILE_SIZE_MB=100

# LiveKit
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=900
LIVEKIT_ROOM_EMPTY_TIMEOUT_SECONDS=300

# Ports
GATEWAY_HTTP_PORT=8081
GATEWAY_MANAGEMENT_PORT=8091
AUTH_HTTP_PORT=8080
AUTH_MANAGEMENT_PORT=8091
USER_HTTP_PORT=8082
USER_MANAGEMENT_PORT=8093
APPOINTMENT_HTTP_PORT=8083
SCHEDULE_HTTP_PORT=8084
SCHEDULE_MANAGEMENT_PORT=8094
CHAT_HTTP_PORT=8085
FILE_HTTP_PORT=8086
VIDEO_HTTP_PORT=8087
NOTIFICATION_HTTP_PORT=8088
EMR_HTTP_PORT=8089
EMR_MANAGEMENT_PORT=8095
GATEWAY_HOST_PORT=8081
GATEWAY_MANAGEMENT_HOST_PORT=8092

# Frontend
FRONTEND_PORT=3000
FRONTEND_OAUTH_CALLBACK_PATH=/oauth/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin bootstrap
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@telemedicine.local
BOOTSTRAP_ADMIN_PASSWORD=Root123456789!

# JWT
PYTHON_SERVICE_JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_ISSUER=auth-service
JWT_AUDIENCE=telemedicine
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_ROLES=patient
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# Python services
APPOINTMENT_ENV=dev
VIDEO_ENVIRONMENT=local
LOG_LEVEL=INFO
APPOINTMENT_DB_POOL_SIZE=5
APPOINTMENT_DB_MAX_OVERFLOW=10
CHAT_RATE_LIMIT_PER_MIN=60
CHAT_MAX_MESSAGE_LENGTH=4096
CHAT_ACCESS_ALLOW_ALL=false

# Email
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Telemed
SMTP_TIMEOUT_SECONDS=15

# Java services
AUTH_ACCESS_TTL=15m
RECONCILE_INITIAL_DELAY=20s
RECONCILE_INTERVAL=1h
PROCESSED_EVENTS_RETENTION=30d
OUTBOX_ENABLED=true
SCHEDULE_MAX_RANGE_DAYS=62
SCHEDULE_MAX_SLOTS_PER_RESPONSE=500
SCHEDULE_SLOT_RETENTION=365d
SCHEDULE_LEAD_TIME=1h
SCHEDULE_MAX_ADVANCE=60d
SCHEDULE_APPOINTMENT_RECONCILE_ENABLED=false
SCHEDULE_HOLD_MINUTES=10080
SCHEDULE_USER_VALIDATION_ENABLED=true
EMR_PAGE_SIZE_MAX=100
EMR_REQUIRE_APPOINTMENT=true
EMR_RETENTION_DAYS=3650
EMR_APPOINTMENT_VALIDATION_ENABLED=false
EMR_FILE_VALIDATION_ENABLED=false
GATEWAY_CONNECT_TIMEOUT_MS=3000
GATEWAY_RESPONSE_TIMEOUT=30s
SPRINGDOC_ENABLED=true

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=168h
